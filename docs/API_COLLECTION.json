  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Service Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Cryptographic Ledger",
      "item": [
        {
          "name": "Get Audit Ledger Blocks (Scoped)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/ledger/blocks?roleScope=regional",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "ledger", "blocks"],
              "query": [{ "key": "roleScope", "value": "regional" }]
            }
          }
        }
      ]
    },
    {
      "name": "Bank CBS Handshake",
      "item": [
        {
          "name": "Trigger Live Core Banking Query",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fdrNumber\": \"SBI-2023-881920\",\n  \"bankCode\": \"SBI\",\n  \"ifsc\": \"SBIN0001055\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/bank/cbs-handshake",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "bank", "cbs-handshake"]
            }
          }
        }
      ]
    },
    {

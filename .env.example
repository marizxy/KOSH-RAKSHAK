# ==============================================================================
# AICTE KOSH-RAKSHAK: ENTERPRISE ENVIRONMENT CONFIGURATION
# Framework: AICTE Approval Process Handbook (APH 2026-27) & Banking Regulation Act Sec 45
# System: Integrated Security Deposit & FDR Lifecycle Portal
# ==============================================================================

# Node & Application Runtime
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_NAME="AICTE KOSH-Rakshak"
APP_URL=http://localhost:5173
API_URL=http://localhost:8080/api/v1

# Security & Cryptographic Tokens
JWT_SECRET=aicte_kosh_rakshak_super_secret_jwt_hmac512_key_2026_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=aicte_kosh_rakshak_refresh_secret_key_2026_super_admin
JWT_REFRESH_EXPIRES_IN=7d
NIC_PARICHAY_CLIENT_ID=parichay_aicte_kosh_prod_01
NIC_PARICHAY_CLIENT_SECRET=parichay_sec_e8392019482910411_fips
NIC_PARICHAY_SSO_URL=https://parichay.nic.in/pnv1/api/auth

# Cryptographic Ledger & Merkle Proof
GENESIS_HASH=7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069
LEDGER_STANDARD=NIST_FIPS_180_4_SHA256
E_SIGN_CERT_PATH=/etc/ssl/certs/nic_etoken_2026.crt

# Database Connection (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aicte_kosh_rakshak_db
DB_USER=postgres
DB_PASSWORD=postgres_secure_password_2026
DATABASE_URL=postgresql://postgres:postgres_secure_password_2026@localhost:5432/aicte_kosh_rakshak_db?schema=public
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis Cache & PubSub Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_auth_token_kosh_2026
REDIS_URL=redis://:redis_auth_token_kosh_2026@localhost:6379/0

# AI Forensics Microservice (Python FastAPI / OpenCV / PyTorch)
AI_FORENSICS_SERVICE_URL=http://localhost:8000
AI_MODEL_WEIGHTS_PATH=./ai-forensics/weights/ela_forgery_detector_v2.pth
TESSERACT_CMD_PATH=/usr/bin/tesseract
OCR_CONFIDENCE_THRESHOLD=0.92
ELA_COMPRESSION_QUALITY=90
ELA_SCALE_FACTOR=15

# Banking Core Banking System (CBS) SFMS Gateway
RBI_SFMS_GATEWAY_URL=https://sfms.rbi.org.in/gateway/v2/mt760
BANK_CBS_TIMEOUT_MS=5000
BANK_API_KEY_SBI=sbi_cbs_live_key_9912048
BANK_API_KEY_PNB=pnb_cbs_live_key_419208
BANK_API_KEY_BOB=bob_cbs_live_key_992318
BANK_API_KEY_CANARA=canara_cbs_live_key_102938

# Multi-Tier Automated Alert & Notification Gateways
SMTP_HOST=smtp.nic.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply-fdr@aicte-india.org
SMTP_PASS=nic_email_relay_token_2026
SMTP_FROM="AICTE KOSH-Rakshak Regulation Bureau <no-reply-fdr@aicte-india.org>"

WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v19.0/aicte_kosh/messages
WHATSAPP_API_TOKEN=wa_auth_token_kosh_rakshak_official_2026
